# Configuration du robot de synchro gdm-dev-rules (lue par sync-all.sh).

# Organisation GitHub et topic qui désigne les apps à synchroniser.
# Pour ajouter une app : Settings du repo → About → Topics → gdm-managed.
GDM_ORG="GUY-DEMARLE"
GDM_TOPIC="gdm-managed"

# Branche utilisée par le robot dans chaque app pour ses PR.
GDM_SYNC_BRANCH="gdm/sync-rules"

# Lead : relecteur demandé sur les PR de première installation.
# Ton pseudo GitHub, précédé de @ (ex : @pseudo), ou une équipe (@GUY-DEMARLE/lead).
GDM_LEAD="@naboucaya-guydemarle"

# App ID de la GitHub App du robot (nombre affiché sur la page de l'App).
# Pas un secret. Sert à proteger-repos.sh pour autoriser le robot à merger
# ses PR sans approbation humaine.
GDM_SYNC_APP_ID="5344897"

# Le lead (rôle admin du repo) peut-il merger sa propre PR sans l'approbation
# de l'autre dev ? Utile en urgence ou en son absence ; GitHub trace chaque
# contournement sur la PR. 1 = oui, 0 = non (deux regards obligatoires).
GDM_LEAD_BYPASS=1

# Délai max (secondes) pendant lequel le robot attend les checks d'une PR avant
# de renoncer à la merger (elle reste ouverte et sera retentée la nuit suivante).
GDM_CHECKS_TIMEOUT="${GDM_CHECKS_TIMEOUT:-1800}"

# Auteur des commits du robot.
GDM_BOT_NAME="gdm-dev-rules[bot]"
GDM_BOT_EMAIL="gdm-dev-rules[bot]@users.noreply.github.com"
